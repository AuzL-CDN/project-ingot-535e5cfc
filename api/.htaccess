# INGOT API .htaccess - IONOS PHP 8.4
# If you ever see raw PHP source in the browser, it means PHP is NOT executing.

# Force PHP 8.4 for .php/.phtml in this directory (IONOS shared hosting)
AddType application/x-httpd-php84 .php .phtml
AddHandler application/x-httpd-php84 .php .phtml

<FilesMatch "\.(php|phtml)$">
    SetHandler application/x-httpd-php84
</FilesMatch>

# Handle preflight OPTIONS requests (CORS handled by PHP in config.php)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
