{
  "name": "Project INGOT Deployment Configuration",
  "version": "1.0.0",
  "description": "Configuration file for deploying Project INGOT to M365 environment",
  
  "sharepoint": {
    "siteCollectionUrl": "https://[TENANT].sharepoint.com/sites/ProjectINGOT",
    "lists": [
      {
        "name": "Inspectors",
        "template": "GenericList",
        "fields": [
          {"name": "Title", "type": "Text", "required": true, "description": "Inspector Name"},
          {"name": "Initials", "type": "Text", "required": true},
          {"name": "Email", "type": "Text", "required": true},
          {"name": "FolderPath", "type": "Text", "required": false}
        ]
      },
      {
        "name": "Activities", 
        "template": "GenericList",
        "fields": [
          {"name": "Title", "type": "Text", "required": true, "description": "Activity Number"},
          {"name": "OrgSiteNumber", "type": "Text", "required": true},
          {"name": "CompanyName", "type": "Text", "required": true},
          {"name": "ClientDepartment", "type": "Text", "required": false},
          {"name": "ContractType", "type": "Choice", "choices": ["Government", "Commercial", "International"]},
          {"name": "ContractNumber", "type": "Text", "required": false},
          {"name": "SecurityLevel", "type": "Choice", "choices": ["Unclassified", "Protected A", "Protected B", "Protected C", "Classified", "Secret", "Top Secret"]},
          {"name": "InspectionType", "type": "Choice", "choices": ["DoC", "Onsite", "Virtual", "Remote"]},
          {"name": "InspectionClass", "type": "Choice", "choices": ["1F", "1G", "19F", "19G"]},
          {"name": "InspectionDate", "type": "DateTime", "required": true},
          {"name": "Status", "type": "Choice", "choices": ["Draft", "In Progress", "Completed", "Archived"]}
        ]
      },
      {
        "name": "CorrectiveMeasures",
        "template": "GenericList", 
        "fields": [
          {"name": "Title", "type": "Text", "required": true, "description": "Auto-generated"},
          {"name": "ActivityNumber", "type": "Text", "required": true},
          {"name": "Index", "type": "Number", "required": true},
          {"name": "MeasureText", "type": "Note", "required": true}
        ]
      },
      {
        "name": "ApprovalCCs",
        "template": "GenericList",
        "fields": [
          {"name": "Title", "type": "Text", "required": true, "description": "Auto-generated"},
          {"name": "ActivityNumber", "type": "Text", "required": true},
          {"name": "Index", "type": "Number", "required": true},
          {"name": "CCName", "type": "Text", "required": true},
          {"name": "CCTitle", "type": "Text", "required": false},
          {"name": "CCDepartment", "type": "Text", "required": false},
          {"name": "CCEmail", "type": "Text", "required": false}
        ]
      },
      {
        "name": "RunLog",
        "template": "GenericList",
        "fields": [
          {"name": "Title", "type": "Text", "required": true, "description": "Auto-generated"},
          {"name": "ActivityNumber", "type": "Text", "required": true},
          {"name": "Action", "type": "Text", "required": true},
          {"name": "Result", "type": "Choice", "choices": ["Success", "Error", "Warning"]},
          {"name": "Message", "type": "Note", "required": false},
          {"name": "FileLink", "type": "URL", "required": false},
          {"name": "Timestamp", "type": "DateTime", "required": true},
          {"name": "Inspector", "type": "Text", "required": false}
        ]
      }
    ],
    "documentLibrary": {
      "name": "Documents",
      "folders": [
        "Templates",
        "Inspectors"
      ]
    }
  },
  
  "azureAD": {
    "appRegistration": {
      "name": "Project INGOT",
      "signInAudience": "AzureADMyOrg",
      "redirectUris": [
        "https://[YOUR-APP].azurestaticapps.net",
        "https://localhost:3000"
      ],
      "requiredResourceAccess": [
        {
          "resourceAppId": "00000003-0000-0000-c000-000000000000",
          "resourceAccess": [
            {
              "id": "205e70e5-aba6-4c52-a976-6d2d46c48043",
              "type": "Scope"
            },
            {
              "id": "5a54b8b3-347c-476d-8f8e-42d5c7424d29",
              "type": "Scope"
            }
          ]
        }
      ]
    }
  },
  
  "powerAutomate": {
    "flows": [
      {
        "name": "INGOT - Create Inspector Folder",
        "trigger": "HTTP Request",
        "description": "Creates folder structure for new inspector"
      },
      {
        "name": "INGOT - Generate Document", 
        "trigger": "HTTP Request",
        "description": "Generates documents from Word templates"
      },
      {
        "name": "INGOT - Upload Supporting Documents",
        "trigger": "HTTP Request", 
        "description": "Handles file uploads to correct folders"
      }
    ]
  },
  
  "deployment": {
    "azureStaticWebApps": {
      "resourceGroup": "rg-project-ingot",
      "location": "West US 2",
      "sku": "Standard",
      "appLocation": "/",
      "apiLocation": "api",
      "outputLocation": "dist"
    }
  },
  
  "environment": {
    "required": [
      "REACT_APP_SHAREPOINT_SITE_URL",
      "REACT_APP_TENANT_ID", 
      "REACT_APP_CLIENT_ID",
      "REACT_APP_POWER_AUTOMATE_BASE_URL"
    ],
    "optional": [
      "REACT_APP_ENVIRONMENT",
      "REACT_APP_API_VERSION"
    ]
  }
}